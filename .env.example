# BayesStack Environment Settings

BAYESSTACK_ENV=development

# Company & Product Identity (Registered Legal Entity)
# COMPANY_NAME="Ahsinam Technologies Private Limited"
# COMPANY_LEGAL_NAME="Ahsinam Technologies Private Limited"
# COMPANY_TRADE_NAME="Ahsinam Technologies"
# COMPANY_CIN="U85500MH2024PTC424430"
# COMPANY_ROC="ROC Mumbai"
# COMPANY_INCORPORATION_DATE="April 29, 2024"
# COMPANY_JURISDICTION="India"
# COMPANY_REGISTERED_ADDRESS="B.K.-1588, ROOM NO-5, SECTION 27, NEAR SATRAMDAS HOSPITAL, Ulhasnagar-4, Thane District, Maharashtra, India, 421004"
# COMPANY_DPO_ADDRESS="Data Protection Office, Ahsinam Technologies Private Limited, B.K.-1588, ROOM NO-5, SECTION 27, NEAR SATRAMDAS HOSPITAL, Ulhasnagar-4, Thane District, Maharashtra, India, 421004"
# PRODUCT_NAME="BayesStack"
# SUPPORT_EMAIL="support@bayesstack.com"
# PRIVACY_EMAIL="privacy@bayesstack.com"
# SECURITY_EMAIL="security@bayesstack.com"

# Multi-Tenant Resolution Base Domains (comma-separated)
BASE_DOMAINS=localhost,bayesstack.com

# PostgreSQL settings for native local development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bayesstack

# DATABASE_URL override if needed
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bayesstack

# Coding Studio. `mock` is safe for ordinary local development; set `piston`
# only when the optional Docker execution profile is running.
JUDGE_SERVICE_URL=http://localhost:2358
EXECUTION_PROVIDER=mock
PISTON_BASE_URL=http://piston:2000
# JUDGE_SERVICE_TOKEN=replace-with-a-shared-internal-secret
